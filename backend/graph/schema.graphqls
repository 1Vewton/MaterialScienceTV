# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Todo {
  id: String!
  text: String!
  done: Boolean!
  dueDateUnixTimestamp: Int!
}

# User defines a single user
type User {
  userID: String!
  userName: String!
  password: String!
  email: String!
}

# Info defines the info for returning
type Info {
  success: Boolean!
  message: String!
}

# ReturnUser defines the schema for returning info to user
type ReturnUser{
  userName: String!
  userID: String!
  email: String!
}

# LoginInfo defines the schema for returing user info when logged in
type LoginInfo{
  success: Boolean!
  message: String!
  info: ReturnUser
}

# GetTodoInfo defines the info for getting todo
type GetTodoInfo{
  success: Boolean!
  message: String!
  todos: [Todo]
}

# NewTodo defines schema for creating todo
input NewTodo {
  text: String!
  dueDateUnixTimestamp: Int!
}

# GetTodoParam defines param for getting todos
input GetTodoParam{
  futureRange: Int
}

# NewUser defines the schema for creating user
input NewUser {
  userName: String!
  password: String!
  email: String!
}

# LoginUserForm defines form for login
input LoginUserForm{
  userName: String
  email: String
  password: String!
}

# MarkTodoForm defines the form for marking todos
input MarkTodoForm{
  todoID: String!
}

# DeleteTodoParam defines the parameter for deleting todo
input DeleteTodoParam{
  todoID: String!
}

# Mutation: Change data
type Mutation {
  # createTodo creates new todo
  createTodo(input: NewTodo!): Info!
  # createUser creates new user
  createUser(input: NewUser!): Info!
  # markTodoFinished marks that the todo is finished
  markTodoFinished(input: MarkTodoForm!): Info!
  # deleteAccount deletes the account
  deleteAccount: Info!
  deleteTodo(input: DeleteTodoParam!): Info!
}

# Query: Get data
type Query {
  # todos gets all the todos
  todos(input: GetTodoParam!): GetTodoInfo!
  # login logins the system
  login(input: LoginUserForm): LoginInfo!
  # verifyUser verifies user
  verifyUser: Info!
}
